  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@ladjs/graceful": "^5.0.0",
    "@polymarket/clob-client": "^5.2.1",
    "better-sqlite3": "^12.6.2",
    "bree": "^9.2.8",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "exponential-backoff": "^3.1.3",
    "ink": "^6.6.0",
    "meow": "^14.0.0",
    "pino": "^10.3.0",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
