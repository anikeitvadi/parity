{
  "name": "prediction-market-scanner",
  "version": "1.0.0",
  "description": "High-confidence mispricing scanner for prediction markets",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "dashboard": "tsx src/cli.tsx",
    "dashboard:watch": "tsx src/cli.tsx --watch"
  },
  "keywords": [
    "prediction-markets",
    "polymarket",
    "kalshi"
  ],
  "author": "",
