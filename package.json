{
  "name": "prediction-market-scanner",
  "version": "1.0.0",
  "description": "Market Efficiency Lab and active prediction-market research terminal.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "dashboard": "tsx src/cli.tsx",
    "dashboard:watch": "tsx src/cli.tsx --watch",
    "dev:server": "tsx --watch server/src/index.ts",
    "dev:client": "vite --config web/vite.config.ts",
    "dev:web": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "check": "npm run typecheck && npm run build:web && npm run test:run",
    "seed": "tsx scripts/seed-demo.ts",
    "study": "tsx scripts/efficiency-study.ts",
    "start:web": "npm run build:web && tsx server/src/index.ts",
    "build:prod": "npm run build && npm run build:web",
    "eval:briefs": "PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/research-brief.promptfooconfig.yaml",
    "eval:briefs:mock": "PROMPTFOO_MOCK=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/research-brief.promptfooconfig.yaml",
    "collect:context": "tsx scripts/collect-market-context.ts"
  },
  "keywords": [
    "prediction-markets",
    "polymarket",
    "kalshi"
  ],
  "author": "",
  "license": "ISC",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@ethersproject/wallet": "^5.8.0",
    "@hono/node-server": "^1.19.13",
    "@inkjs/ui": "^2.0.0",
    "@ladjs/graceful": "^5.0.0",
    "@observablehq/plot": "^0.6.17",
    "@polymarket/clob-client": "^5.2.1",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.6.2",
    "bree": "^9.2.8",
    "chalk": "^5.6.2",
    "chrono-node": "^2.9.0",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "exponential-backoff": "^3.1.3",
    "hono": "^4.12.12",
    "ink": "^6.6.0",
    "meow": "^14.0.0",
    "openai": "^6.34.0",
    "pino": "^10.3.0",
    "react": "^19.2.4",
    "sqlite-vec": "^0.1.9",
    "string-similarity": "^4.0.4",
    "tsx": "^4.22.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "promptfoo": "^0.118.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.0.18"
  }
}
