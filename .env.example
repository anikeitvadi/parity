# Prediction Market Edge Scanner - Environment Variables
# Copy this file to .env and fill in your credentials

# Application environment (development | production | test)
NODE_ENV=development

# =============================================================================
# Polymarket Credentials
# =============================================================================

# Ethereum private key for CLOB authentication
# Create a separate "hot wallet" with minimal funds ($1-5 for gas)
# NEVER use your main wallet private key
POLYMARKET_PRIVATE_KEY=your_64_char_hex_private_key_here

# Optional: Polymarket API key for Gamma API (if required)
# POLYMARKET_API_KEY=your_api_key_here

# =============================================================================
# Kalshi Credentials
# =============================================================================

# Kalshi API credentials
# Get these from: Kalshi Dashboard -> Settings -> API Keys -> Create New
KALSHI_API_KEY=your_api_key_here
KALSHI_API_SECRET=your_api_secret_here

# Optional: Use demo API for testing (set to 'true' for demo mode)
# KALSHI_USE_DEMO=false
