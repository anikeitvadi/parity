# Prediction Market Scanner - Environment Variables
#
# Quick start (no API keys needed):
#   cp .env.example .env
#   npm run dev:web          # Web app at localhost:5173
#   npm run dashboard --demo # CLI with sample data
#
# Everything below DEMO_MODE is optional. The app works without any credentials.

NODE_ENV=development
DEMO_MODE=true

# =============================================================================
# Market API Credentials (optional — public data works without these)
# =============================================================================

# Polymarket: Ethereum private key for CLOB auth (order books only)
# Create a separate "hot wallet" — NEVER use your main wallet
# POLYMARKET_PRIVATE_KEY=

# Kalshi: API credentials (market reads work without auth)
# Get from: Kalshi Dashboard -> Settings -> API Keys
# KALSHI_API_KEY=
# KALSHI_API_SECRET=
# KALSHI_USE_DEMO=false

# =============================================================================
# AI Research Briefs (optional)
# =============================================================================

# xAI API key — enables AI research briefs with real-time X/Twitter data (PREFERRED)
# $25 free credits, no credit card needed. Sign up: https://console.x.ai
# XAI_API_KEY=

# OpenAI API key — fallback if xAI key not set
# OPENAI_API_KEY=

# =============================================================================
# Web Server (optional)
# =============================================================================

# PORT=3001
